{
  "name": "@xrsps/eyes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Eyes for coding agents: drives the XRSPS browser client in headless Chromium (screenshots, game state, input) via MCP or CLI.",
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": "./src/cli.js",
  "scripts": {
    "install-browser": "playwright install chromium",
    "mcp": "node src/mcp.js",
    "serve": "node src/cli.js serve",
    "test": "node tests/smoke.test.js",
    "test:duel": "yarn test:duel-native && yarn test:duel-native-flow && yarn test:duel-native-shop",
    "test:duel-lobby": "yarn test:duel-native-flow",
    "test:duel-chat": "yarn test:duel-native",
    "test:duel-camera": "yarn test:duel-native",
    "test:duel-context": "yarn test:duel-native",
    "test:duel-reload": "yarn test:duel-native-flow",
    "test:duel-ui": "yarn test:duel-native",
    "test:duel-shop": "yarn test:duel-native-shop",
    "test:duel-native": "node tests/duel-native-foundation.test.js",
    "test:duel-native-flow": "node tests/duel-native-flow.test.js",
    "test:duel-native-shop": "node tests/duel-native-shop.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "playwright": "^1.55.0",
    "zod": "^3.25.0"
  }
}
